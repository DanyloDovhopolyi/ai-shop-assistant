# Copy to .env.local and fill in. Never commit real values.

# Gemini API key for the AI chat (https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase project for semantic search (Project Settings -> API)
SUPABASE_URL=
# Secret key (sb_secret_...). Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
