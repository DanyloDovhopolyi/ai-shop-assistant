{
  "name": "ai-shop-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
